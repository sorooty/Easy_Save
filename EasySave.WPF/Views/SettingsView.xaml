<UserControl x:Class="EasySave.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EasySave.ViewModel;assembly=EasySave.ViewModel"
             xmlns:res="clr-namespace:EasySave.WPF.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type vm:SettingsViewModel}}"
             Background="{StaticResource SurfaceBrush}">

    <ScrollViewer Style="{StaticResource ThinScrollViewerStyle}"
                  Padding="40,32"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Stretch">

            <!-- Title -->
            <TextBlock Text="{x:Static res:Strings.Settings_Title}"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,0,0,28"/>

            <!-- === Log format === -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_LogFormat}"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{x:Static res:Strings.Settings_Json}"
                                     IsChecked="{Binding UseJson}"
                                     FontFamily="{StaticResource FontMain}"
                                     FontSize="{StaticResource FontSizeBase}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Margin="0,0,24,0"/>
                        <RadioButton Content="{x:Static res:Strings.Settings_Xml}"
                                     IsChecked="{Binding UseXml}"
                                     FontFamily="{StaticResource FontMain}"
                                     FontSize="{StaticResource FontSizeBase}"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- === Language === -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_Language}"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{x:Static res:Strings.Settings_English}"
                                     IsChecked="{Binding UseEnglish}"
                                     FontFamily="{StaticResource FontMain}"
                                     FontSize="{StaticResource FontSizeBase}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Margin="0,0,24,0"/>
                        <RadioButton Content="{x:Static res:Strings.Settings_French}"
                                     IsChecked="{Binding UseFrench}"
                                     FontFamily="{StaticResource FontMain}"
                                     FontSize="{StaticResource FontSizeBase}"
                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- === Encrypted extensions === -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_Extensions}"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="0,0,0,8"/>
                    <TextBox Text="{Binding EncryptedExtensions, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>
            </Border>

            <!-- === Business software === -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_BusinessApp}"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="0,0,0,8"/>
                    <TextBox Text="{Binding BusinessSoftwareName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>
            </Border>

            <!-- === CryptoSoft path === -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Settings_CryptoSoft}"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="0,0,0,8"/>
                    <TextBox Text="{Binding CryptoSoftPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"/>
                </StackPanel>
            </Border>

            <!-- Save button + feedback -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{x:Static res:Strings.Settings_Save}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,16,0"/>
                <Button Content="{x:Static res:Strings.Settings_OpenLogs}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenLogsFolderCommand}"
                        Margin="0,0,16,0"/>
                <TextBlock Text="{Binding SavedMessage}"
                           Foreground="{StaticResource SuccessBrush}"
                           FontFamily="{StaticResource FontMain}"
                           FontSize="{StaticResource FontSizeBase}"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasSavedMessage, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
