<UserControl x:Class="EasySave.WPF.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EasySave.ViewModel;assembly=EasySave.ViewModel"
             xmlns:res="clr-namespace:EasySave.WPF.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type vm:HelpViewModel}}"
             Background="{StaticResource SurfaceBrush}">

    <ScrollViewer Style="{StaticResource ThinScrollViewerStyle}"
                  Padding="24,20"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,12,0">

            <!-- Page title -->
            <TextBlock Text="{x:Static res:Strings.Help_Title}"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,0,0,24"/>

            <!-- Section: Backup Jobs -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Help_Section_Jobs}"
                               Style="{StaticResource PanelTitleStyle}"
                               Margin="0,0,0,12"/>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Help_Jobs_Step1}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Jobs_Step2}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Jobs_Step3}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Jobs_Step4}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Jobs_Step5}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Jobs_Step6}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Jobs_Step7}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section: Settings -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Help_Section_Settings}"
                               Style="{StaticResource PanelTitleStyle}"
                               Margin="0,0,0,12"/>
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_LogFormat_Label}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_LogFormat_Desc}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" Margin="0,2,0,0" LineHeight="20"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_Language_Label}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_Language_Desc}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" Margin="0,2,0,0" LineHeight="20"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_Encrypted_Label}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_Encrypted_Desc}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" Margin="0,2,0,0" LineHeight="20"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_Priority_Label}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_Priority_Desc}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" Margin="0,2,0,0" LineHeight="20"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_Business_Label}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_Business_Desc}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" Margin="0,2,0,0" LineHeight="20"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_LargeFile_Label}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_LargeFile_Desc}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" Margin="0,2,0,0" LineHeight="20"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_CryptoSoft_Label}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                            <TextBlock Text="{x:Static res:Strings.Help_Settings_CryptoSoft_Desc}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" Margin="0,2,0,0" LineHeight="20"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section: Logs -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Help_Section_Logs}"
                               Style="{StaticResource PanelTitleStyle}"
                               Margin="0,0,0,12"/>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Help_Logs_Desc1}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Logs_Desc2}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Logs_Desc3}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Logs_Desc4}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section: Docker -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Help_Section_Docker}"
                               Style="{StaticResource PanelTitleStyle}"
                               Margin="0,0,0,12"/>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Help_Docker_Desc1}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Docker_Desc2}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Docker_Desc3}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Docker_Desc4}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Docker_Desc5}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                        <TextBlock Text="{x:Static res:Strings.Help_Docker_Desc6}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
