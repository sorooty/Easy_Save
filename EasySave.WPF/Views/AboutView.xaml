<UserControl x:Class="EasySave.WPF.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EasySave.ViewModel;assembly=EasySave.ViewModel"
             xmlns:res="clr-namespace:EasySave.WPF.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type={x:Type vm:AboutViewModel}}"
             Background="{StaticResource SurfaceBrush}">

    <ScrollViewer Style="{StaticResource ThinScrollViewerStyle}"
                  Padding="24,20"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,12,0">

            <!-- Banner -->
            <Border Margin="0,0,0,24" CornerRadius="6" ClipToBounds="True">
                <Image Source="pack://application:,,,/EasySave.WPF;component/Resources/banner.png"
                       Stretch="UniformToFill"
                       Height="180"/>
            </Border>

            <!-- Title and Version -->
            <TextBlock Text="{x:Static res:Strings.About_Title}"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,0,0,8"/>
            <TextBlock Margin="0,0,0,24">
                <Run Text="{x:Static res:Strings.About_Version}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Run Text=" v3.0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Run Text=" - " Foreground="{StaticResource TextSecondaryBrush}"/>
                <Run Text="{x:Static res:Strings.About_Date}" Foreground="{StaticResource TextSecondaryBrush}"/>
            </TextBlock>

            <!-- Project Description -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.About_Project_Title}"
                               Style="{StaticResource PanelTitleStyle}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{x:Static res:Strings.About_Project_Desc}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource FontMain}"
                               FontSize="{StaticResource FontSizeBase}"
                               LineHeight="20"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{x:Static res:Strings.About_Project_Details}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource FontMain}"
                               FontSize="{StaticResource FontSizeBase}"
                               LineHeight="20"/>
                </StackPanel>
            </Border>

            <!-- Key Features -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.About_Features_Title}"
                               Style="{StaticResource PanelTitleStyle}"
                               Margin="0,0,0,12"/>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.About_Features_Backup}" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                        <TextBlock Text="{x:Static res:Strings.About_Features_Parallel}" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                        <TextBlock Text="{x:Static res:Strings.About_Features_Priority}" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                        <TextBlock Text="{x:Static res:Strings.About_Features_Bandwidth}" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                        <TextBlock Text="{x:Static res:Strings.About_Features_Docker}" Margin="0,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Technical Details -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.About_Technical_Title}"
                               Style="{StaticResource PanelTitleStyle}"
                               Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{x:Static res:Strings.About_Tech_Language}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="C# / .NET 8.0" Grid.Column="1" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Text="{x:Static res:Strings.About_Tech_Interface}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Grid.Row="1"/>
                        <TextBlock Text="WPF / MVVM" Grid.Column="1" Grid.Row="1" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Text="{x:Static res:Strings.About_Tech_Platform}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Grid.Row="2"/>
                        <TextBlock Text="Windows" Grid.Column="1" Grid.Row="2" Foreground="{StaticResource TextSecondaryBrush}"/>

                        <TextBlock Text="{x:Static res:Strings.About_Tech_Repository}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Grid.Row="3"/>
                        <TextBlock Grid.Column="1" Grid.Row="3" Foreground="{StaticResource TextSecondaryBrush}">
                            <Hyperlink NavigateUri="https://github.com/sorooty/Easy_Save">github.com/sorooty/Easy_Save</Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Getting Started -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.About_GetStarted_Title}"
                               Style="{StaticResource PanelTitleStyle}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{x:Static res:Strings.About_GetStarted_Step1}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                    <TextBlock Text="{x:Static res:Strings.About_GetStarted_Step2}" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                    <TextBlock Text="{x:Static res:Strings.About_GetStarted_Step3}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource FontMain}" FontSize="{StaticResource FontSizeBase}" LineHeight="20"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
